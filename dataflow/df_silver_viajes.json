{
	"name": "df_silver_viajes",
	"properties": {
		"folder": {
			"name": "Silver"
		},
		"type": "MappingDataFlow",
		"typeProperties": {
			"sources": [
				{
					"dataset": {
						"referenceName": "dw_bronze_viajes_sql",
						"type": "DatasetReference"
					},
					"name": "source1"
				}
			],
			"sinks": [
				{
					"dataset": {
						"referenceName": "dw_silver_viajes_sql",
						"type": "DatasetReference"
					},
					"name": "sink1"
				}
			],
			"transformations": [
				{
					"name": "filter1"
				},
				{
					"name": "derivedColumn1"
				},
				{
					"name": "derivedColumn2"
				},
				{
					"name": "derivedColumn3"
				}
			],
			"scriptLines": [
				"source(output(",
				"          AnioFuente as string,",
				"          ViajeId as string,",
				"          RutaHistoricaId as string,",
				"          VehiculoId as string,",
				"          FechaServicio as string,",
				"          HoraProgramada as string,",
				"          HoraSalida as string,",
				"          HoraLlegada as string,",
				"          ValidacionesTarjeta as string,",
				"          KmRecorridos as string,",
				"          EstadoViaje as string",
				"     ),",
				"     allowSchemaDrift: true,",
				"     validateSchema: false,",
				"     isolationLevel: 'READ_UNCOMMITTED',",
				"     format: 'table') ~> source1",
				"source1 filter(!startsWith(upper(trim(toString(ViajeId))), 'TOTAL_')",
				"&& !isNull(FechaServicio) && trim(toString(FechaServicio)) != ''",
				"&& !isNull(RutaHistoricaId) && trim(toString(RutaHistoricaId)) != ''",
				"&& !isNull(VehiculoId) && trim(toString(VehiculoId)) != ''",
				"&& !isNull(HoraProgramada) && trim(toString(HoraProgramada)) != ''",
				"&& !isNull(HoraSalida) && trim(toString(HoraSalida)) != ''",
				"&& !isNull(HoraLlegada) && trim(toString(HoraLlegada)) != ''",
				"&& !isNull(ValidacionesTarjeta) && trim(toString(ValidacionesTarjeta)) != ''",
				"&& !isNull(KmRecorridos) && trim(toString(KmRecorridos)) != ''",
				"&& !isNull(EstadoViaje) && trim(toString(EstadoViaje)) != '') ~> filter1",
				"filter1 derive(FechaServicio = iif(\r",
				"    instr(toString(FechaServicio), '/') > 0,\r",
				"    toDate(toString(FechaServicio), 'dd/MM/yyyy'),\r",
				"    toDate(toString(FechaServicio), 'yyyy-MM-dd')\r",
				"),",
				"          ViajeId = upper(trim(toString(ViajeId))),",
				"          VehiculoId = upper(trim(toString(VehiculoId))),",
				"          RutaHistoricaId = concat(\r",
				"    'RH-',\r",
				"    lpad(\r",
				"        regexReplace(upper(trim(toString(RutaHistoricaId))), '[^0-9]', ''),\r",
				"        2,\r",
				"        '0'\r",
				"    )\r",
				")) ~> derivedColumn1",
				"derivedColumn1 derive(HoraProgramada = toTimestamp(\r",
				"    concat(\r",
				"        '2000-01-01 ',\r",
				"        iif(\r",
				"            instr(toString(HoraProgramada), 'T') > 0\r",
				"            || instr(toString(HoraProgramada), ' ') > 0,\r",
				"            substring(toString(HoraProgramada), 12, 8),\r",
				"            iif(\r",
				"                length(toString(HoraProgramada)) == 5,\r",
				"                concat(toString(HoraProgramada), ':00'),\r",
				"                substring(toString(HoraProgramada), 1, 8)\r",
				"            )\r",
				"        )\r",
				"    ),\r",
				"    'yyyy-MM-dd HH:mm:ss'\r",
				"),",
				"          HoraSalida = toTimestamp(\r",
				"    concat(\r",
				"        '2000-01-01 ',\r",
				"        iif(\r",
				"            instr(toString(HoraSalida), 'T') > 0\r",
				"            || instr(toString(HoraSalida), ' ') > 0,\r",
				"            substring(toString(HoraSalida), 12, 8),\r",
				"            iif(\r",
				"                length(toString(HoraSalida)) == 5,\r",
				"                concat(toString(HoraSalida), ':00'),\r",
				"                substring(toString(HoraSalida), 1, 8)\r",
				"            )\r",
				"        )\r",
				"    ),\r",
				"    'yyyy-MM-dd HH:mm:ss'\r",
				"),",
				"          HoraLlegada = toTimestamp(\r",
				"    concat(\r",
				"        '2000-01-01 ',\r",
				"        iif(\r",
				"            instr(toString(HoraLlegada), 'T') > 0\r",
				"            || instr(toString(HoraLlegada), ' ') > 0,\r",
				"            substring(toString(HoraLlegada), 12, 8),\r",
				"            iif(\r",
				"                length(toString(HoraLlegada)) == 5,\r",
				"                concat(toString(HoraLlegada), ':00'),\r",
				"                substring(toString(HoraLlegada), 1, 8)\r",
				"            )\r",
				"        )\r",
				"    ),\r",
				"    'yyyy-MM-dd HH:mm:ss'\r",
				")) ~> derivedColumn2",
				"derivedColumn2 derive(ValidacionesTarjeta = toInteger(trim(toString(ValidacionesTarjeta))),",
				"          KmRecorridos = toDecimal(replace(trim(toString(KmRecorridos)), ',', '.'), 8, 1),",
				"          EstadoViaje = upper(trim(toString(EstadoViaje)))) ~> derivedColumn3",
				"derivedColumn3 sink(allowSchemaDrift: true,",
				"     validateSchema: false,",
				"     input(",
				"          ViajeId as string,",
				"          RutaHistoricaId as string,",
				"          VehiculoId as string,",
				"          FechaServicio as date,",
				"          HoraProgramada as timestamp,",
				"          HoraSalida as timestamp,",
				"          HoraLlegada as timestamp,",
				"          ValidacionesTarjeta as integer,",
				"          KmRecorridos as decimal(8,1),",
				"          EstadoViaje as string",
				"     ),",
				"     deletable:false,",
				"     insertable:true,",
				"     updateable:false,",
				"     upsertable:false,",
				"     format: 'table',",
				"     skipDuplicateMapInputs: true,",
				"     skipDuplicateMapOutputs: true,",
				"     errorHandlingOption: 'stopOnFirstError',",
				"     mapColumn(",
				"          ViajeId,",
				"          RutaHistoricaId,",
				"          VehiculoId,",
				"          FechaServicio,",
				"          HoraProgramada,",
				"          HoraSalida,",
				"          HoraLlegada,",
				"          ValidacionesTarjeta,",
				"          KmRecorridos,",
				"          EstadoViaje",
				"     )) ~> sink1"
			]
		}
	}
}