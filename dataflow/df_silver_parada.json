{
	"name": "df_silver_parada",
	"properties": {
		"folder": {
			"name": "Silver"
		},
		"type": "MappingDataFlow",
		"typeProperties": {
			"sources": [
				{
					"dataset": {
						"referenceName": "dw_bronze_paradas_sql",
						"type": "DatasetReference"
					},
					"name": "source1"
				}
			],
			"sinks": [
				{
					"dataset": {
						"referenceName": "dw_silver_paradas_sql",
						"type": "DatasetReference"
					},
					"name": "sink1"
				}
			],
			"transformations": [
				{
					"name": "derivedColumn1"
				},
				{
					"name": "derivedColumn2"
				},
				{
					"name": "derivedColumn3"
				},
				{
					"name": "aggregate1"
				},
				{
					"name": "filter1"
				}
			],
			"scriptLines": [
				"source(output(",
				"          AnioFuente as string,",
				"          ParadaHistoricaId as string,",
				"          CodigoPublicado as string,",
				"          NombreParada as string,",
				"          Zona as string,",
				"          Latitud as string,",
				"          Longitud as string,",
				"          VigenciaDesde as string,",
				"          VigenciaHasta as string,",
				"          Estado as string",
				"     ),",
				"     allowSchemaDrift: true,",
				"     validateSchema: false,",
				"     isolationLevel: 'READ_UNCOMMITTED',",
				"     format: 'table') ~> source1",
				"filter1 derive(ParadaHistoricaId = concat(\r",
				"    'P',\r",
				"    lpad(\r",
				"        regexExtract(\r",
				"            upper(trim(toString(ParadaHistoricaId))),\r",
				"            '([0-9]+)',\r",
				"            1\r",
				"        ),\r",
				"        3,\r",
				"        '0'\r",
				"    )\r",
				"),",
				"          CodigoPublicado = iif(isNull(CodigoPublicado) || trim(toString(CodigoPublicado)) == '', upper(trim(toString(ParadaHistoricaId))), upper(trim(toString(CodigoPublicado)))),",
				"          NombreParada = regexReplace(trim(toString(NombreParada)), ' +', ' '),",
				"          Zona = upper(regexReplace(trim(toString(Zona)), ' +', ' ')),",
				"          Estado = upper(trim(toString(Estado)))) ~> derivedColumn1",
				"aggregate1 derive(Latitud = toDecimal(trim(toString(Latitud)), 9, 6),",
				"          Longitud = toDecimal(trim(toString(Longitud)), 9, 6)) ~> derivedColumn2",
				"derivedColumn2 derive(VigenciaDesde = iif(isNull(VigenciaDesde) || trim(toString(VigenciaDesde)) == '',\r",
				"    toDate(null()),\r",
				"    iif(isInteger(trim(toString(VigenciaDesde))),\r",
				"        addDays(toDate('1899-12-30'), toInteger(trim(toString(VigenciaDesde)))),\r",
				"        iif(isDate(trim(toString(VigenciaDesde)), 'dd/MM/yyyy'),\r",
				"            toDate(trim(toString(VigenciaDesde)), 'dd/MM/yyyy'),\r",
				"            iif(isDate(trim(toString(VigenciaDesde)), 'yyyy-MM-dd'),\r",
				"                toDate(trim(toString(VigenciaDesde)), 'yyyy-MM-dd'),\r",
				"                toDate(null())\r",
				"            )\r",
				"        )\r",
				"    )\r",
				"),",
				"          VigenciaHasta = iif(isNull(VigenciaHasta) || trim(toString(VigenciaHasta)) == '',\r",
				"    toDate(null()),\r",
				"    iif(isInteger(trim(toString(VigenciaHasta))),\r",
				"        addDays(toDate('1899-12-30'), toInteger(trim(toString(VigenciaHasta)))),\r",
				"        iif(isDate(trim(toString(VigenciaHasta)), 'dd/MM/yyyy'),\r",
				"            toDate(trim(toString(VigenciaHasta)), 'dd/MM/yyyy'),\r",
				"            iif(isDate(trim(toString(VigenciaHasta)), 'yyyy-MM-dd'),\r",
				"                toDate(trim(toString(VigenciaHasta)), 'yyyy-MM-dd'),\r",
				"                toDate(null())\r",
				"            )\r",
				"        )\r",
				"    )\r",
				")) ~> derivedColumn3",
				"derivedColumn1 aggregate(groupBy(ParadaHistoricaId),",
				"     CodigoPublicado = first(CodigoPublicado),",
				"          NombreParada = first(NombreParada),",
				"          Zona = first(Zona),",
				"          Latitud = first(Latitud),",
				"          Longitud = first(Longitud),",
				"          VigenciaDesde = first(VigenciaDesde),",
				"          VigenciaHasta = first(VigenciaHasta),",
				"          Estado = first(Estado)) ~> aggregate1",
				"source1 filter(!isNull(ParadaHistoricaId)",
				"&& trim(toString(ParadaHistoricaId)) != ''",
				"&& regexMatch(trim(toString(ParadaHistoricaId)), '[0-9]+')) ~> filter1",
				"derivedColumn3 sink(allowSchemaDrift: true,",
				"     validateSchema: false,",
				"     input(",
				"          ParadaHistoricaId as string,",
				"          CodigoPublicado as string,",
				"          NombreParada as string,",
				"          Zona as string,",
				"          Latitud as decimal(9,6),",
				"          Longitud as decimal(9,6),",
				"          VigenciaDesde as date,",
				"          VigenciaHasta as date,",
				"          Estado as string",
				"     ),",
				"     deletable:false,",
				"     insertable:true,",
				"     updateable:false,",
				"     upsertable:false,",
				"     format: 'table',",
				"     skipDuplicateMapInputs: true,",
				"     skipDuplicateMapOutputs: true,",
				"     errorHandlingOption: 'stopOnFirstError') ~> sink1"
			]
		}
	}
}