{
	"name": "df_silver_rutas",
	"properties": {
		"folder": {
			"name": "Silver"
		},
		"type": "MappingDataFlow",
		"typeProperties": {
			"sources": [
				{
					"dataset": {
						"referenceName": "dw_bronze_rutas_sql",
						"type": "DatasetReference"
					},
					"name": "source1"
				}
			],
			"sinks": [
				{
					"dataset": {
						"referenceName": "dw_silver_rutas_sql",
						"type": "DatasetReference"
					},
					"name": "sink1"
				}
			],
			"transformations": [
				{
					"name": "derivedColumn1"
				},
				{
					"name": "derivedColumn2"
				},
				{
					"name": "aggregate1"
				}
			],
			"scriptLines": [
				"source(output(",
				"          AnioFuente as string,",
				"          RutaHistoricaId as string,",
				"          CodigoRuta as string,",
				"          NombreRuta as string,",
				"          Origen as string,",
				"          Destino as string,",
				"          VigenciaDesde as string,",
				"          VigenciaHasta as string,",
				"          Estado as string",
				"     ),",
				"     allowSchemaDrift: true,",
				"     validateSchema: false,",
				"     isolationLevel: 'READ_UNCOMMITTED',",
				"     format: 'table') ~> source1",
				"source1 derive(RutaHistoricaId = concat(\r",
				"    'RH-',\r",
				"    lpad(\r",
				"        regexReplace(upper(trim(toString(CodigoRuta))), '[^0-9]', ''),\r",
				"        2,\r",
				"        '0'\r",
				"    )\r",
				"),",
				"          CodigoRuta = concat(\r",
				"    'R-',\r",
				"    lpad(\r",
				"        regexReplace(upper(trim(toString(CodigoRuta))), '[^0-9]', ''),\r",
				"        2,\r",
				"        '0'\r",
				"    )\r",
				"),",
				"          NombreRuta = trim(toString(NombreRuta)),",
				"          Origen = trim(toString(Origen)),",
				"          Destino = trim(toString(Destino)),",
				"          Estado = upper(trim(toString(Estado)))) ~> derivedColumn1",
				"aggregate1 derive(VigenciaDesde = iif(\r",
				"    instr(toString(VigenciaDesde), '/') > 0,\r",
				"    toDate(toString(VigenciaDesde), 'dd/MM/yyyy'),\r",
				"    iif(\r",
				"        instr(toString(VigenciaDesde), '-') > 0,\r",
				"        toDate(toString(VigenciaDesde), 'yyyy-MM-dd'),\r",
				"        addDays(\r",
				"            toDate('1899-12-30'),\r",
				"            toInteger(toString(VigenciaDesde))\r",
				"        )\r",
				"    )\r",
				"),",
				"          VigenciaHasta = iif(\r",
				"    instr(toString(VigenciaHasta), '/') > 0,\r",
				"    toDate(toString(VigenciaHasta), 'dd/MM/yyyy'),\r",
				"    iif(\r",
				"        instr(toString(VigenciaHasta), '-') > 0,\r",
				"        toDate(toString(VigenciaHasta), 'yyyy-MM-dd'),\r",
				"        addDays(\r",
				"            toDate('1899-12-30'),\r",
				"            toInteger(toString(VigenciaHasta))\r",
				"        )\r",
				"    )\r",
				")) ~> derivedColumn2",
				"derivedColumn1 aggregate(groupBy(RutaHistoricaId),",
				"     CodigoRuta = first(CodigoRuta),",
				"          NombreRuta = first(NombreRuta),",
				"          Origen = first(Origen),",
				"          Destino = first(Destino),",
				"          VigenciaDesde = first(VigenciaDesde),",
				"          VigenciaHasta = first(VigenciaHasta),",
				"          Estado = first(Estado)) ~> aggregate1",
				"derivedColumn2 sink(allowSchemaDrift: true,",
				"     validateSchema: false,",
				"     input(",
				"          RutaHistoricaId as string,",
				"          CodigoRuta as string,",
				"          NombreRuta as string,",
				"          Origen as string,",
				"          Destino as string,",
				"          VigenciaDesde as date,",
				"          VigenciaHasta as date,",
				"          Estado as string",
				"     ),",
				"     deletable:false,",
				"     insertable:true,",
				"     updateable:false,",
				"     upsertable:false,",
				"     format: 'table',",
				"     skipDuplicateMapInputs: true,",
				"     skipDuplicateMapOutputs: true,",
				"     errorHandlingOption: 'stopOnFirstError') ~> sink1"
			]
		}
	}
}