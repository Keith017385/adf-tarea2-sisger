{
	"name": "df_silver_incidentes",
	"properties": {
		"folder": {
			"name": "Silver"
		},
		"type": "MappingDataFlow",
		"typeProperties": {
			"sources": [
				{
					"dataset": {
						"referenceName": "dw_bronze_incidentes_sql",
						"type": "DatasetReference"
					},
					"name": "source1"
				}
			],
			"sinks": [
				{
					"dataset": {
						"referenceName": "dw_silver_incidentes_sql",
						"type": "DatasetReference"
					},
					"name": "sink1"
				}
			],
			"transformations": [
				{
					"name": "derivedColumn1"
				},
				{
					"name": "derivedColumn2"
				},
				{
					"name": "derivedColumn3"
				},
				{
					"name": "filter1"
				}
			],
			"scriptLines": [
				"source(output(",
				"          AnioFuente as string,",
				"          IncidenteId as string,",
				"          TipoIncidente as string,",
				"          Severidad as string,",
				"          FechaHoraInicio as string,",
				"          FechaHoraFin as string,",
				"          FechaHoraRegistro as string,",
				"          VehiculoId as string,",
				"          Descripcion as string",
				"     ),",
				"     allowSchemaDrift: true,",
				"     validateSchema: false,",
				"     isolationLevel: 'READ_UNCOMMITTED',",
				"     format: 'table') ~> source1",
				"source1 derive(AnioFuente = iif(\r",
				"    isNull(AnioFuente) || trim(toString(AnioFuente)) == '',\r",
				"    toInteger(substring(toString(IncidenteId), 4, 4)),\r",
				"    toInteger(trim(toString(AnioFuente)))\r",
				"),",
				"          IncidenteId = upper(trim(toString(IncidenteId)))\r",
				",",
				"          TipoIncidente = upper(trim(toString(TipoIncidente))),",
				"          Severidad = upper(trim(toString(Severidad))),",
				"          Descripcion = trim(toString(Descripcion))) ~> derivedColumn1",
				"derivedColumn1 derive(FechaHoraInicio = iif(\r",
				"    instr(toString(FechaHoraInicio), '1899-12-31T') > 0,\r",
				"    toTimestamp(\r",
				"        concat(\r",
				"            substring(toString(FechaHoraInicio), 1, 10),\r",
				"            ' ',\r",
				"            substring(toString(FechaHoraInicio), 23, 8)\r",
				"        ),\r",
				"        'yyyy-MM-dd HH:mm:ss'\r",
				"    ),\r",
				"    iif(\r",
				"        instr(toString(FechaHoraInicio), '/') > 0,\r",
				"        toTimestamp(toString(FechaHoraInicio), 'dd/MM/yyyy HH:mm'),\r",
				"        iif(\r",
				"            length(toString(FechaHoraInicio)) == 19,\r",
				"            toTimestamp(toString(FechaHoraInicio), 'yyyy-MM-dd HH:mm:ss'),\r",
				"            toTimestamp(toString(FechaHoraInicio), 'yyyy-MM-dd HH:mm')\r",
				"        )\r",
				"    )\r",
				"),",
				"          FechaHoraRegistro = iif(\r",
				"    instr(toString(FechaHoraRegistro), '/') > 0,\r",
				"    toTimestamp(toString(FechaHoraRegistro), 'dd/MM/yyyy'),\r",
				"    iif(\r",
				"        length(toString(FechaHoraRegistro)) == 19,\r",
				"        toTimestamp(toString(FechaHoraRegistro), 'yyyy-MM-dd HH:mm:ss'),\r",
				"        toTimestamp(toString(FechaHoraRegistro), 'yyyy-MM-dd')\r",
				"    )\r",
				"),",
				"          FechaHoraFin = iif(\r",
				"    instr(toString(FechaHoraFin), '1899-12-31T') > 0,\r",
				"    toTimestamp(\r",
				"        concat(\r",
				"            substring(toString(FechaHoraFin), 1, 10),\r",
				"            ' ',\r",
				"            substring(toString(FechaHoraFin), 23, 8)\r",
				"        ),\r",
				"        'yyyy-MM-dd HH:mm:ss'\r",
				"    ),\r",
				"    iif(\r",
				"        instr(toString(FechaHoraFin), '/') > 0,\r",
				"        toTimestamp(toString(FechaHoraFin), 'dd/MM/yyyy HH:mm'),\r",
				"        iif(\r",
				"            length(toString(FechaHoraFin)) == 19,\r",
				"            toTimestamp(toString(FechaHoraFin), 'yyyy-MM-dd HH:mm:ss'),\r",
				"            toTimestamp(toString(FechaHoraFin), 'yyyy-MM-dd HH:mm')\r",
				"        )\r",
				"    )\r",
				")) ~> derivedColumn2",
				"derivedColumn2 derive(VehiculoId = iif(\r",
				"    isNull(VehiculoId) || trim(toString(VehiculoId)) == '',\r",
				"    toString(null()),\r",
				"    upper(trim(toString(VehiculoId)))\r",
				")) ~> derivedColumn3",
				"derivedColumn3 filter(!isNull(VehiculoId)",
				"&& trim(toString(VehiculoId)) != '') ~> filter1",
				"filter1 sink(allowSchemaDrift: true,",
				"     validateSchema: false,",
				"     input(",
				"          IncidenteId as string,",
				"          TipoIncidente as string,",
				"          Severidad as string,",
				"          FechaHoraInicio as timestamp,",
				"          FechaHoraFin as timestamp,",
				"          FechaHoraRegistro as timestamp,",
				"          VehiculoId as string,",
				"          Descripcion as string",
				"     ),",
				"     deletable:false,",
				"     insertable:true,",
				"     updateable:false,",
				"     upsertable:false,",
				"     format: 'table',",
				"     skipDuplicateMapInputs: true,",
				"     skipDuplicateMapOutputs: true,",
				"     errorHandlingOption: 'stopOnFirstError',",
				"     mapColumn(",
				"          IncidenteId,",
				"          TipoIncidente,",
				"          Severidad,",
				"          FechaHoraInicio,",
				"          FechaHoraFin,",
				"          VehiculoId,",
				"          Descripcion",
				"     )) ~> sink1"
			]
		}
	}
}