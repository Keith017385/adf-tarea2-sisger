{
	"name": "df_silver_demanda_paradas",
	"properties": {
		"folder": {
			"name": "Silver"
		},
		"type": "MappingDataFlow",
		"typeProperties": {
			"sources": [
				{
					"dataset": {
						"referenceName": "dw_bronze_demanda_paradas_sql",
						"type": "DatasetReference"
					},
					"name": "source1"
				}
			],
			"sinks": [
				{
					"dataset": {
						"referenceName": "dw_silver_demanda_paradas_sql",
						"type": "DatasetReference"
					},
					"name": "sink1"
				}
			],
			"transformations": [
				{
					"name": "filter1"
				},
				{
					"name": "derivedColumn1"
				},
				{
					"name": "derivedColumn2"
				},
				{
					"name": "derivedColumn3"
				}
			],
			"scriptLines": [
				"source(output(",
				"          AnioFuente as string,",
				"          DemandaId as string,",
				"          FechaServicio as string,",
				"          RutaHistoricaId as string,",
				"          ParadaHistoricaId as string,",
				"          Franja as string,",
				"          ValidacionesTarjeta as string,",
				"          Descensos as string,",
				"          DemandaNoAtendida as string,",
				"          Metodo as string",
				"     ),",
				"     allowSchemaDrift: true,",
				"     validateSchema: false,",
				"     isolationLevel: 'READ_UNCOMMITTED',",
				"     format: 'table') ~> source1",
				"source1 filter(!isNull(DemandaId)",
				"&& trim(toString(DemandaId)) != ''",
				"&& !isNull(ValidacionesTarjeta)",
				"&& trim(toString(ValidacionesTarjeta)) != '') ~> filter1",
				"filter1 derive(DemandaId = upper(trim(toString(DemandaId))),",
				"          RutaHistoricaId = iif(\r",
				"    toInteger(regexReplace(upper(trim(toString(RutaHistoricaId))), '[^0-9]', '')) < 10,\r",
				"    concat('RH-0', toString(toInteger(regexReplace(upper(trim(toString(RutaHistoricaId))), '[^0-9]', '')))),\r",
				"    concat('RH-', toString(toInteger(regexReplace(upper(trim(toString(RutaHistoricaId))), '[^0-9]', ''))))\r",
				"),",
				"          ParadaHistoricaId = iif(\r",
				"    upper(trim(toString(ParadaHistoricaId))) == 'MC-01',\r",
				"    'P219',\r",
				"    iif(\r",
				"        toInteger(regexReplace(upper(trim(toString(ParadaHistoricaId))), '[^0-9]', '')) < 10,\r",
				"        concat('P00', toString(toInteger(regexReplace(upper(trim(toString(ParadaHistoricaId))), '[^0-9]', '')))),\r",
				"        iif(\r",
				"            toInteger(regexReplace(upper(trim(toString(ParadaHistoricaId))), '[^0-9]', '')) < 100,\r",
				"            concat('P0', toString(toInteger(regexReplace(upper(trim(toString(ParadaHistoricaId))), '[^0-9]', '')))),\r",
				"            concat('P', toString(toInteger(regexReplace(upper(trim(toString(ParadaHistoricaId))), '[^0-9]', ''))))\r",
				"        )\r",
				"    )\r",
				"),",
				"          Franja = trim(toString(Franja)),",
				"          Metodo = upper(trim(toString(Metodo)))) ~> derivedColumn1",
				"derivedColumn1 derive(FechaServicio = iif(\r",
				"    regexMatch(trim(toString(FechaServicio)), '^[0-9]{4}-[0-9]{2}-[0-9]{2}$'),\r",
				"    toDate(trim(toString(FechaServicio)), 'yyyy-MM-dd'),\r",
				"    iif(\r",
				"        regexMatch(trim(toString(FechaServicio)), '^[0-9]{2}/[0-9]{2}/[0-9]{4}$'),\r",
				"        toDate(trim(toString(FechaServicio)), 'dd/MM/yyyy'),\r",
				"        addDays(toDate('1899-12-30'), toInteger(trim(toString(FechaServicio))))\r",
				"    )\r",
				")) ~> derivedColumn2",
				"derivedColumn2 derive(ValidacionesTarjeta = toInteger(ValidacionesTarjeta),",
				"          Descensos = toInteger(Descensos),",
				"          DemandaNoAtendida = toInteger(DemandaNoAtendida)) ~> derivedColumn3",
				"derivedColumn3 sink(allowSchemaDrift: true,",
				"     validateSchema: false,",
				"     input(",
				"          DemandaId as string,",
				"          FechaServicio as date,",
				"          RutaHistoricaId as string,",
				"          ParadaHistoricaId as string,",
				"          Franja as string,",
				"          ValidacionesTarjeta as integer,",
				"          Descensos as integer,",
				"          DemandaNoAtendida as integer,",
				"          Metodo as string",
				"     ),",
				"     deletable:false,",
				"     insertable:true,",
				"     updateable:false,",
				"     upsertable:false,",
				"     format: 'table',",
				"     skipDuplicateMapInputs: true,",
				"     skipDuplicateMapOutputs: true,",
				"     errorHandlingOption: 'stopOnFirstError') ~> sink1"
			]
		}
	}
}